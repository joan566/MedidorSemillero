<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.savings.SavingListController"
      spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Ahorros" styleClass="page-title"/>
            <Label text="Consulta y registra los ahorros de cada participante." styleClass="page-subtitle"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Registrar ahorro" onAction="#handleNewSaving" styleClass="primary-button"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="personFilterCombo"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="personColumn" text="Persona" prefWidth="200"/>
            <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="110"/>
            <TableColumn fx:id="amountColumn" text="Valor" prefWidth="120" styleClass="money-column"/>
            <TableColumn fx:id="methodColumn" text="Medio" prefWidth="130"/>
            <TableColumn fx:id="notesColumn" text="Observación" prefWidth="220"/>
        </columns>
    </TableView>
</VBox>
