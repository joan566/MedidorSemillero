<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.savings.controller.PersonSavingsTabController"
      spacing="12" style="-fx-padding: 16;">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Registrar ahorro" onAction="#handleNewSaving" styleClass="primary-button"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="120"/>
            <TableColumn fx:id="amountColumn" text="Valor" prefWidth="140" styleClass="money-column"/>
            <TableColumn fx:id="methodColumn" text="Medio" prefWidth="140"/>
            <TableColumn fx:id="notesColumn" text="Observación" prefWidth="260"/>
        </columns>
    </TableView>
</VBox>
