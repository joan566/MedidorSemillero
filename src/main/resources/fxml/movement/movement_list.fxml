<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.movement.controller.MovementListController"
      spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Movimientos" styleClass="page-title"/>
            <Label text="Historial completo de ingresos y egresos del fondo." styleClass="page-subtitle"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Registrar ingreso" onAction="#handleNewIncome" styleClass="primary-button"/>
        <Button text="+ Registrar egreso" onAction="#handleNewExpense" styleClass="secondary-button"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Desde"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="Hasta"/>
        <DatePicker fx:id="toDatePicker"/>
        <ComboBox fx:id="kindCombo"/>
        <ComboBox fx:id="fundCombo"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="methodCombo"/>
        <ComboBox fx:id="personCombo"/>
        <ComboBox fx:id="typeCombo"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Limpiar filtros" onAction="#handleClearFilters" styleClass="secondary-button"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="100"/>
            <TableColumn fx:id="kindColumn" text="Tipo" prefWidth="80"/>
            <TableColumn fx:id="categoryColumn" text="Categoría" prefWidth="160"/>
            <TableColumn fx:id="fundColumn" text="Fondo" prefWidth="150"/>
            <TableColumn fx:id="methodColumn" text="Medio" prefWidth="120"/>
            <TableColumn fx:id="personColumn" text="Persona" prefWidth="160"/>
            <TableColumn fx:id="valueColumn" text="Valor" prefWidth="120" styleClass="money-column"/>
        </columns>
    </TableView>
</VBox>
