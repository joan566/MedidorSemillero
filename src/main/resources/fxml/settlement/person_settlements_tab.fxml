<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.settlement.PersonSettlementsTabController"
      spacing="12" style="-fx-padding: 16;">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Preparar liquidación" onAction="#handlePrepareForYear" styleClass="primary-button"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="clickable-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="yearColumn" text="Año" prefWidth="80"/>
            <TableColumn fx:id="savingsColumn" text="Ahorro" prefWidth="130" styleClass="money-column"/>
            <TableColumn fx:id="interestColumn" text="Interés" prefWidth="130" styleClass="money-column"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="130" styleClass="money-column"/>
            <TableColumn fx:id="preparedAtColumn" text="Preparada el" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
