<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.settlement.controller.SettlementListController"
      spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Liquidaciones" styleClass="page-title"/>
            <Label text="Calcula y consulta cuánto corresponde devolver a cada participante." styleClass="page-subtitle"/>
        </VBox>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Año"/>
        <ComboBox fx:id="yearCombo"/>
    </HBox>
    <VBox styleClass="card" spacing="4">
        <Label text="Total a liquidar" styleClass="metric-label"/>
        <Label fx:id="yearTotalLabel" styleClass="metric-hero"/>
    </VBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="clickable-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="personColumn" text="Persona" prefWidth="200"/>
            <TableColumn fx:id="savingsColumn" text="Ahorro" prefWidth="130" styleClass="money-column"/>
            <TableColumn fx:id="interestColumn" text="Interés" prefWidth="130" styleClass="money-column"/>
            <TableColumn fx:id="totalColumn" text="Total a liquidar" prefWidth="140" styleClass="money-column"/>
            <TableColumn fx:id="statusColumn" text="Estado" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
