<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.loan.controller.LoanPaymentFormController"
      spacing="10" prefWidth="360">
    <padding>
        <Insets top="16" right="16" bottom="4" left="16"/>
    </padding>
    <Label text="Datos del pago" styleClass="section-title"/>
    <Label fx:id="interestOwedLabel" styleClass="metric-label"/>
    <Label fx:id="principalBalanceLabel" styleClass="metric-label"/>
    <Label text="Valor del pago" styleClass="field-label"/>
    <TextField fx:id="amountField" promptText="Ej: 100000"/>
    <Label fx:id="breakdownPreviewLabel" wrapText="true" styleClass="metric-label"/>
    <Label text="Fecha" styleClass="field-label"/>
    <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
    <Label text="Medio de pago" styleClass="field-label"/>
    <ComboBox fx:id="methodCombo" maxWidth="Infinity"/>
    <Label text="Observación (opcional)" styleClass="field-label"/>
    <TextField fx:id="notesField"/>
    <Label fx:id="errorLabel" styleClass="field-error" wrapText="true" visible="false" managed="false"/>
</VBox>
