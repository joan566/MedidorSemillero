<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.loan.LoanDetailController"
      spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="← Volver" onAction="#handleBack" styleClass="secondary-button"/>
    </HBox>
    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label fx:id="personLabel" styleClass="page-title"/>
        <Label fx:id="statusLabel" style="-fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="registerPaymentButton" text="Registrar pago" onAction="#handleRegisterPayment" styleClass="primary-button"/>
    </HBox>
    <HBox spacing="16">
        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="MONTO PRESTADO" styleClass="metric-label"/>
            <Label fx:id="principalLabel" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="INTERÉS" styleClass="metric-label"/>
            <Label fx:id="interestLabel" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="TOTAL A PAGAR" styleClass="metric-label"/>
            <Label fx:id="totalLabel" styleClass="metric-value"/>
        </VBox>
    </HBox>
    <HBox spacing="16">
        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="PAGADO" styleClass="metric-label"/>
            <Label fx:id="paidLabel" styleClass="metric-value value-income"/>
        </VBox>
        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="PENDIENTE" styleClass="metric-label"/>
            <Label fx:id="outstandingLabel" styleClass="metric-value value-expense"/>
        </VBox>
    </HBox>
    <HBox spacing="24">
        <VBox spacing="4">
            <Label text="Fecha del préstamo" styleClass="metric-label"/>
            <Label fx:id="dateLabel"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Observación" styleClass="metric-label"/>
            <Label fx:id="notesLabel"/>
        </VBox>
    </HBox>
    <Label text="Historial de pagos" styleClass="section-title"/>
    <TableView fx:id="paymentsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="paymentDateColumn" text="Fecha" prefWidth="120"/>
            <TableColumn fx:id="paymentAmountColumn" text="Valor" prefWidth="140" styleClass="money-column"/>
            <TableColumn fx:id="paymentMethodColumn" text="Medio" prefWidth="140"/>
            <TableColumn fx:id="paymentNotesColumn" text="Observación" prefWidth="260"/>
        </columns>
    </TableView>
</VBox>
