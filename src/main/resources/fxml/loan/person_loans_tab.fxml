<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.loan.PersonLoansTabController"
      spacing="12" style="-fx-padding: 16;">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Nuevo préstamo" onAction="#handleNewLoan" styleClass="primary-button"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="clickable-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="100"/>
            <TableColumn fx:id="amountColumn" text="Monto" prefWidth="110" styleClass="money-column"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="110" styleClass="money-column"/>
            <TableColumn fx:id="outstandingColumn" text="Pendiente" prefWidth="110" styleClass="money-column"/>
            <TableColumn fx:id="statusColumn" text="Estado" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>
