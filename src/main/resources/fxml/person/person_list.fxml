<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.playground.fondoahorro.presentation.person.controller.PersonListController"
      spacing="16">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Personas" styleClass="page-title"/>
            <Label text="Administra los participantes del fondo." styleClass="page-subtitle"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="+ Nueva persona" onAction="#handleNewPerson" styleClass="primary-button"/>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Buscar por nombre..." HBox.hgrow="ALWAYS"/>
        <CheckBox fx:id="includeInactiveCheckBox" text="Mostrar inactivas"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="clickable-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameColumn" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="birthDateColumn" text="Fecha de nacimiento" prefWidth="150"/>
            <TableColumn fx:id="phoneColumn" text="Teléfono" prefWidth="130"/>
            <TableColumn fx:id="savingsColumn" text="Ahorro" prefWidth="130" styleClass="money-column"/>
            <TableColumn fx:id="debtColumn" text="Deuda" prefWidth="130" styleClass="money-column"/>
            <TableColumn fx:id="statusColumn" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
